SCANNER_ENV=production
# Replace every example value before deployment. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SCANNER_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SCANNER_AUTH_USERNAME=replace-this-username
SCANNER_AUTH_PASSWORD=replace-with-a-unique-password-at-least-20-characters
# Public hostname users will use, with no scheme or port.
SCANNER_ALLOWED_HOSTS=scanner.example.com,localhost,127.0.0.1
SCANNER_RATE_LIMIT_STORAGE=memory://
